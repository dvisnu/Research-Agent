# Copy to .env and fill in the keys. .env is gitignored, so keys stay on this machine.

# Where the database, checkpoints and run reports go.
RA_DATA_DIR=var

# ---------------------------------------------------------------------------
# LLMs
# ---------------------------------------------------------------------------
# Free-tier models for development. We move to stronger models once the whole
# agent works (see END_TODO.md).
#
# Each role is provider:model. A comma-separated list adds fallbacks: when a
# model's quota is used up (HTTP 429 after retries), the role moves to the next
# model for the rest of the session. The trace records which model answered.
# The verifier must use a different model family from reasoning.

# Extraction (cheap, high volume): the relevance check now, paper extraction from Phase 2.
#   Gemini 3.5 / 3.1 Flash-Lite: 15 requests/min, 250k tokens/min, 500 requests/day each.
#   Gemma 4 31B: 30 requests/min, 16k tokens/min, 14.4k requests/day.
RA_LLM_EXTRACTION=google:gemini-3.5-flash-lite,google:gemini-3.1-flash-lite,google:gemma-4-31b-it

# Reasoning: the research brief now; gaps, ideas and plans in later phases.
#   Nemotron 3 Ultra (free): 5 requests/min. OpenRouter allows 50 requests/day
#   across all its free models together (1,000/day once the account has bought
#   $10 of credit).
RA_LLM_REASONING=openrouter:nvidia/nemotron-3-ultra-550b-a55b:free

# Verifier, from Phase 5: checks every cited claim.
#   gpt-oss-120b on Groq: 30 requests/min, 8k tokens/min, 1k requests/day, 200k tokens/day.
RA_LLM_VERIFIER=groq:openai/gpt-oss-120b

# Provider API keys.
# Google AI Studio: https://aistudio.google.com/apikey
RA_GOOGLE_API_KEY=
# OpenRouter: https://openrouter.ai/settings/keys
RA_OPENROUTER_API_KEY=
# Groq: https://console.groq.com/keys
RA_GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Literature
# ---------------------------------------------------------------------------
# Semantic Scholar API key. Its limit is 1 request per second across all
# endpoints; the client enforces this machine-wide, so never call the API
# directly. Without a key, most requests get HTTP 429.
RA_S2_API_KEY=

# OpenAlex API key (free; how to get one: https://help.openalex.org/api/authentication/)
# Without it, requests share a small daily budget with everyone on your IP
# address, which runs out; then OpenAlex search is skipped until midnight UTC.
RA_OPENALEX_API_KEY=

# Contact email: required by Unpaywall; puts OpenAlex requests in its polite pool.
RA_CONTACT_EMAIL=

# Corpus size per run: the top papers read in full, then the next ones by abstract.
# Development sizes, sized for the free LLM tiers.
RA_FULL_READ=10
RA_ABSTRACT_ONLY=30

# Development only: reuse full texts parsed by an earlier run instead of
# downloading them again. Remove (or set false) for the product.
RA_REUSE_TEXTS=true
